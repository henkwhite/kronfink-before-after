#. Plugin Name of the plugin
#: kronfink-before-after.php
msgid "Kronfink Before / After"
msgstr "Kronfink Vorher / Nachher"

#. Plugin URI of the plugin
#: kronfink-before-after.php
msgid "https://github.com/henkwhite/kronfink-before-after"
msgstr "https://github.com/henkwhite/kronfink-before-after"

#. Description of the plugin
#: kronfink-before-after.php
msgid "A deliberately simple before/after image comparison block. Two images, one slider, nothing else."
msgstr "Ein bewusst simpler Block für Vorher-Nachher-Bildvergleiche. Zwei Bilder, ein Schieberegler, sonst nichts."

#. Author of the plugin
#: kronfink-before-after.php
msgid "Kronfink"
msgstr "Kronfink"

#: src/render.php:118
#: src/edit.js:370
msgid "Comparison position between the before and after image"
msgstr "Vergleichsposition zwischen Vorher- und Nachher-Bild"

#: src/edit.js:195
msgid "Before image"
msgstr "Vorher-Bild"

#: src/edit.js:206
msgid "After image"
msgstr "Nachher-Bild"

#: src/edit.js:228
msgid "Replace before"
msgstr "Vorher-Bild ersetzen"

#: src/edit.js:236
msgid "Replace after"
msgstr "Nachher-Bild ersetzen"

#: src/edit.js:241
msgid "Comparison"
msgstr "Vergleich"

#: src/edit.js:244
msgid "The two images have different aspect ratios. The after image is cropped to match the before image."
msgstr "Die beiden Bilder haben unterschiedliche Seitenverhältnisse. Das Nachher-Bild wird auf das Vorher-Bild zugeschnitten."

#: src/edit.js:252
msgid "Start position"
msgstr "Startposition"

#: src/edit.js:266
msgid "Before image alt text"
msgstr "Alt-Text des Vorher-Bildes"

#: src/edit.js:271
#: src/edit.js:282
msgid "Taken from the media library"
msgstr "Aus der Mediathek übernommen"

#: src/edit.js:277
msgid "After image alt text"
msgstr "Alt-Text des Nachher-Bildes"

#: src/edit.js:287
msgid "Visible section of the after image"
msgstr "Sichtbarer Ausschnitt des Nachher-Bildes"

#: src/edit.js:288
msgid "Decides which part stays in view when the after image is cropped to the before image."
msgstr "Legt fest, welcher Teil sichtbar bleibt, wenn das Nachher-Bild auf das Vorher-Bild zugeschnitten wird."

#: src/edit.js:302
msgid "Colour"
msgstr "Farbe"

#: src/edit.js:308
